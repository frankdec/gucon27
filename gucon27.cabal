name:               gucon27
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  other-modules:    Talk
  build-depends:    base == 4.*
                  , hakyll == 4.16.*
                  , filepath == 1.5.*
                  , binary
                  , bytestring
                  , aeson
                  , yaml
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
